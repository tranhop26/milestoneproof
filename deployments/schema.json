{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milestoneproof.dev/schemas/deployment-manifest.json",
  "title": "MilestoneProof deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "network",
    "contractAddress",
    "deploymentTransactionHash",
    "deployerAddress",
    "sourceSha256",
    "deployedAt",
    "classification",
    "explorerUrl",
    "verification"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "network": { "enum": ["studionet", "testnet-asimov", "testnet-bradbury"] },
    "contractAddress": { "$ref": "#/$defs/address" },
    "deploymentTransactionHash": { "$ref": "#/$defs/hash" },
    "deployerAddress": { "$ref": "#/$defs/address" },
    "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "deployedAt": { "type": "string", "format": "date-time" },
    "classification": { "const": "INTENTIONALLY_FROZEN" },
    "explorerUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionHash",
        "transactionStatus",
        "executionResult",
        "verifiedAt",
        "sourceMatches",
        "configReadback"
      ],
      "properties": {
        "transactionHash": { "$ref": "#/$defs/hash" },
        "transactionStatus": { "const": "FINALIZED" },
        "executionResult": { "const": "FINISHED_WITH_RETURN" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "sourceMatches": { "const": true },
        "configReadback": {
          "type": "array",
          "prefixItems": [
            { "const": 0 },
            { "const": 3 },
            { "const": 3 },
            { "const": 4 },
            { "const": 3 },
            { "const": 259200 }
          ],
          "minItems": 6,
          "maxItems": 6
        }
      }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
  }
}
