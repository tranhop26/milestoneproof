{
  "name": "@milestoneproof/shared",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:consumer": "pnpm run build && tsc -p scripts/tsconfig.consumer.json && node scripts/consumer-test.mjs"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "ipaddr.js": "2.2.0"
  }
}
